# Database
DATABASE_URL="postgresql://postgres:yourpassword@postgres:5432/yourdbname"
DATABASE_NAME=yourdbname
DATABASE_USER=postgres
DATABASE_PWD=yourpassword

# JWT Secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key
JWT_EMAIL_SECRET_KEY=your_jwt_email_secret_key

# Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_TOKEN_EXPIRE_MINUTES=60

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery broker/result backend — same Redis instance as above, different DB
# index so its keys don't collide with the cache/rate-limiter. Optional,
# defaults to 1.
# CELERY_BROKER_DB=1

# Resend (get from https://resend.com/api-keys). FROM_EMAIL must be on a domain you've verified
# with Resend, or the sandbox address onboarding@resend.dev — with an unverified domain Resend's
# free tier also only delivers to the account owner's own address, regardless of `to`.
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=your_email@example.com

# Dev-only convenience: with the placeholder RESEND_API_KEY above, real
# email delivery always fails locally. Set DEBUG=true to print each email
# (including verification/password-reset tokens) to the console instead of
# losing them in a failed send. Leave unset/false in production — these
# bodies carry live auth tokens.
DEBUG=false

# Public base URL of this API (used to build the email verification link).
# Override with your deployed domain in production.
BASE_URL=http://localhost:8000

# Public base URL of the frontend (used to build PayPal's return_url/
# cancel_url). Override with your deployed frontend domain in production.
FRONTEND_BASE_URL=http://localhost:8080

# Comma-separated frontend origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:8080

# Image storage (see app/utils/storage.py) — local disk by default, no
# S3 fields required. To deploy with S3 (or an S3-compatible provider —
# DigitalOcean Spaces, Cloudflare R2, MinIO, ...), set:
#   STORAGE_BACKEND=s3
#   S3_BUCKET_NAME=your-bucket
#   S3_REGION=us-east-1
#   AWS_ACCESS_KEY_ID=...        # omit to fall back to boto3's normal credential chain
#   AWS_SECRET_ACCESS_KEY=...
#   S3_ENDPOINT_URL=...          # only for S3-compatible providers, leave unset for real AWS S3
#   S3_PUBLIC_URL_BASE=...       # optional CDN/custom domain fronting the bucket
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
LOCAL_UPLOAD_URL_PREFIX=/uploads

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Password for every account scripts/seed.py creates (admin/managers/fans). Optional — defaults to
# a hardcoded value in the script if unset, which is fine for a throwaway local dev DB but must be
# overridden before ever running the seed script against a real deployed database.
# SEED_PASSWORD=