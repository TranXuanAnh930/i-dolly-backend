          <mxGeometry x="720" y="10" width="420" height="1550" as="geometry" />
        </mxCell>
        <mxCell id="n201" value="Flow A — Buy album / single / EP /
lightstick / merch (fully independent of the lottery)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n202" value="Fan adds album/single/EP/lightstick/merch
to cart and checks out" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n203" value="Existing checkout flow:
create Order / OrderItem / Payment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n204" value="trg_orders_items_resale_cap:
is this product&#x27;s category is_resale_capped
(true by default for EVERY category, incl. Merch),
and would this push the SAME product_id
past 3 lifetime units for this fan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n205" value="Reject this line —
anti-resale cap (§4.2).
All products are capped by default now;
a category can opt out via UPDATE." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="305" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n206" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="n204" target="n205">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n207" value="Payment assumed to succeed
(mock gateway, this phase)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n208" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#82B366;" edge="1" parent="1" source="n204" target="n207">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n209" value="Order complete.
No lottery_entries row is ever created
as a side effect of this flow." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n210" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n202" target="n203">
