          <mxGeometry x="740" y="810" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n230" value="Won at this rank?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="930" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n231" value="Stays pending — rolls
