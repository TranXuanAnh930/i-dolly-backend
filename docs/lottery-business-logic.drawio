        <mxCell id="n212" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n207" target="n209">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n213" value="Physical formats keep using
ShippingAddress / ShippingStatus unmodified.
Digital formats skip shipping entirely." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=10;fontColor=#666666;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n215" value="Flow B — Apply to a concert&#x27;s lottery directly
(fully independent of purchases — free)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n216" value="Fan ranks tier preferences for a concert
(e.g. 1st VIP, 2nd Premium, 3rd Regular)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="100" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n217" value="Upsert lottery_preferences rows
(concert_id, user_id, ticket_type_id, rank)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="190" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n218" value="Fan applies to ONE specific tier&#x27;s lottery
(no cart, no payment, no purchase at all)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="280" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n219" value="fn_require_lottery_preference:
has this fan ranked that tier
for this concert?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="370" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n220" value="Reject the application —
no rank, no entry (§3.11)." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="390" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n221" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="n219" target="n220">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n222" value="trg_lottery_entries_cap:
has this fan already reached this
campaign&#x27;s max_entries_per_user
(default 1, a campaign-level knob)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="480" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n223" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#82B366;" edge="1" parent="1" source="n219" target="n222">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n224" value="Reject — at the cap.
One entry per campaign by default;
raisable per-campaign via UPDATE (§3.13)." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
