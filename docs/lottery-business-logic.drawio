          <mxGeometry x="740" y="590" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n227" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#82B366;" edge="1" parent="1" source="n222" target="n226">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n228" value="AT DRAW TIME — campaigns for ONE concert
